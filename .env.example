# ============================================================================
# FormMaker Docker & Self-Hosted Environment Configuration
# Copy this file to .env (`cp .env.example .env`) and customize values
# ============================================================================

# 1. Database (PostgreSQL in Docker)
DB_USER=formmaker
DB_PASSWORD=changeme_secure_password
DB_NAME=formmaker

# 2. Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
AUTH_SECRET=change_this_to_a_random_32_character_string

# 3. Domain & Public App URL
# For Secondary PC / Local IP testing (HTTP):
DOMAIN_NAME=:80
NEXT_PUBLIC_APP_URL=http://localhost

# For Production In-House Server with Public Domain & Auto SSL (uncomment & update):
# DOMAIN_NAME=forms.yourdomain.com
# NEXT_PUBLIC_APP_URL=https://forms.yourdomain.com
