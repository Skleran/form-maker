# ============================================================================
# FormMaker Docker & Self-Hosted Environment Configuration
# Copy this file to .env (`cp .env.example .env`) and fill in every empty value.
# The app refuses to start in production if these are missing or left as defaults.
# ============================================================================

# 1. Database (PostgreSQL in Docker)
DB_USER=formmaker
DB_PASSWORD=
DB_NAME=formmaker

# 2. Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# At least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# 3. Domain & Public App URL
# For Secondary PC / Local IP testing (HTTP):
DOMAIN_NAME=:80
NEXT_PUBLIC_APP_URL=http://localhost

# For Production In-House Server with Public Domain & Auto SSL (uncomment & update):
# DOMAIN_NAME=forms.yourdomain.com
# NEXT_PUBLIC_APP_URL=https://forms.yourdomain.com

# ============================================================================
# Local development
# Run `docker compose -f docker-compose.dev.yml up -d`, then put these in
# .env.local, which Next.js prefers over .env (the blank values turn Supabase off):
#
# DATABASE_URL="postgresql://formmaker:formmaker_dev@127.0.0.1:5433/formmaker"
# DIRECT_URL="postgresql://formmaker:formmaker_dev@127.0.0.1:5433/formmaker"
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# The Prisma CLI reads only .env, so pass the URLs when running it:
# DATABASE_URL=... DIRECT_URL=... npx prisma db push
# ============================================================================
